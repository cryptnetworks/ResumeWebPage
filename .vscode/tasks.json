{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run",
      "type": "shell",
      "command": "yarn dev",
      "problemMatcher": []
    },
    {
      "label": "debug",
      "type": "shell",
      "command": "yarn debug",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "yarn build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "yarn lint",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
